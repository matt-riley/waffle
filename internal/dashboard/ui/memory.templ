package ui

templ MemoryAssets(view ShellView) {
	<link rel="stylesheet" href={ AssetURL("memory.css", view.AssetVersion) }/>
	<script type="module" src={ AssetURL("memory.js", view.AssetVersion) }></script>
}

templ Memory(view ShellView) {
	<section class="memory" aria-labelledby="memory-title">
		<header class="memory-header">
			<div>
				<p class="eyebrow">Memory</p>
				<h1 id="memory-title">Memory</h1>
				<p>Find the exact source, pin a bounded reference to a session, or archive a Waffle-owned note.</p>
			</div>
			<a class="memory-conversation-link" href="/desk/?section=today">Add through conversation</a>
		</header>
		<div class="memory-layout">
			<div class="memory-search-panel">
				<form id="memory-search-form" class="memory-search-form" hx-get="/api/v1/desk/memory" hx-target="#memory-results" hx-swap="outerHTML">
					<label for="memory-query">Search turns, summaries, and notes</label>
					<div class="memory-search-row">
						<input id="memory-query" name="query" type="search" maxlength="1024" autocomplete="off" placeholder="What do you need to recall?"/>
						<button type="submit">Search memory</button>
					</div>
				</form>
				<p id="memory-status" class="memory-status" aria-live="polite">Enter a search to begin.</p>
				<div id="memory-results" class="memory-results"></div>
			</div>
			<aside class="memory-attach-panel" aria-labelledby="memory-attach-title">
				<p class="eyebrow">Working set</p>
				<h2 id="memory-attach-title">Attach to a session</h2>
				<p>Choose an explicit persisted session. Attached references are pinned, user-sourced facts and stay within the working-set limits.</p>
				<label id="memory-session-label" for="memory-session-trigger">Attach to session</label>
				@MemorySessionPicker(MemorySessionPickerView{Loading: true, Load: true})
				<div id="memory-attach-status" class="memory-status" aria-live="polite"></div>
			</aside>
		</div>
		<dialog id="memory-forget-dialog" class="memory-forget-dialog" aria-labelledby="memory-forget-title">
			<h2 id="memory-forget-title">Archive this note?</h2>
			<p id="memory-forget-note"></p>
			<p id="memory-forget-scope"></p>
			<ul id="memory-forget-exclusions"></ul>
			<p>This confirmation expires after 60 seconds.</p>
			<div class="memory-dialog-actions">
				<button id="memory-forget-cancel" data-waffle-dialog-cancel type="button" autofocus>Cancel</button>
				<button id="memory-forget-confirm" class="danger-button" type="button">Forget note</button>
			</div>
		</dialog>
	</section>
}

templ MemorySessionPicker(view MemorySessionPickerView) {
	<div class="memory-session-field" id="memory-session-field" if view.Load { hx-get="/api/v1/desk/memory/sessions" hx-trigger="load" hx-target="#memory-session-field" hx-swap="outerHTML" }>
		<input id="memory-session" name="session_id" type="hidden" value=""/>
		if view.Loading {
			<button id="memory-session-trigger" class="memory-session-trigger" type="button" disabled aria-haspopup="listbox" aria-expanded="false">Loading conversations…</button>
			<p id="memory-session-status" class="memory-session-hint visually-hidden" role="status" aria-live="polite">Loading conversations…</p>
		} else if view.Error {
			<p class="memory-session-hint" id="memory-session-error">Conversations could not be loaded.</p>
			<button id="memory-session-retry" type="button" hx-get="/api/v1/desk/memory/sessions" hx-target="#memory-session-field" hx-swap="outerHTML">Try again</button>
		} else if len(view.Choices) == 0 {
			<p class="memory-session-hint" id="memory-session-empty">No persisted conversations yet. <a href="/desk/?section=today">Start one in Today</a> to attach memory to it.</p>
		} else {
			<button id="memory-session-trigger" class="memory-session-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="memory-session-popover">Select a conversation…</button>
			<div id="memory-session-popover" class="memory-session-popover" hidden>
				<label for="memory-session-query">Find a conversation</label>
				<input id="memory-session-query" type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="memory-session-options" aria-activedescendant="" autocomplete="off"/>
				<div id="memory-session-options" role="listbox" aria-label="Persisted conversations"></div>
				<p id="memory-session-no-matches" class="memory-session-hint" role="status" hidden>No conversations match.</p>
			</div>
			<button id="memory-session-clear" class="memory-session-clear" type="button" hidden>Clear selection</button>
			<div id="memory-session-choice-data" hidden aria-hidden="true">
				for _, choice := range view.Choices {
					<span class="memory-session-choice-data" data-session-id={ choice.ID } data-session-title={ choice.Label } data-session-summary={ choice.Summary } data-session-model-alias={ choice.ModelAlias } data-session-updated-at={ choice.UpdatedAt } data-session-pinned={ fragmentBool(choice.Pinned) }></span>
				}
			</div>
			<p class="memory-session-hint" id="memory-session-empty" hidden></p>
		}
	</div>
}
