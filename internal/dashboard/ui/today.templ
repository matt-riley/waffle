package ui

templ Today(view ShellView) {
	<script type="module" src={ AssetURL("read-aloud.js", view.AssetVersion) }></script>
	<script src={ AssetURL("dictate.js", view.AssetVersion) }></script>
	<section class="today" aria-labelledby="desk-session-title">
		<header class="today-header">
			<div>
				<p class="eyebrow">Today</p>
				<h1 id="desk-session-title">{ view.Title }</h1>
			</div>
			<p class="phase-label" id="desk-phase" role="status" aria-live="polite">Opening</p>
			<p class="connection" id="desk-connection">
				<span class="connection-light" aria-hidden="true"></span>
				<span id="desk-connection-text">{ view.Connection }</span>
			</p>
			<button type="button" id="desk-conversations-open" class="conversations-open" aria-controls="desk-sessions" hidden>Conversations</button>
			<button type="button" id="desk-context-toggle" class="context-toggle" aria-controls="desk-canvas-drawer" aria-expanded="false">Session and files</button>
		</header>
		@SetupBanner()
		<div class="stale-banner" id="desk-stale-status" role="status" aria-live="polite" tabindex="-1" hidden>
			<div>
				<strong id="desk-stale-label">This desk is out of date.</strong>
				<span id="desk-stale-message">The transcript is still here, but sending is paused.</span>
			</div>
			<div class="stale-actions">
				<button type="button" id="desk-refresh">Refresh Desk</button>
			</div>
		</div>
		<div class="recovery-navigation" id="desk-recovery-navigation" aria-label="Conversation recovery navigation" hidden></div>
		<div class="today-columns">
			<section class="conversation" aria-labelledby="desk-session-title">
				<div class="conversation-column">
					<div class="message-list" id="desk-transcript" aria-label="Conversation transcript">
						<p class="empty-transcript" id="desk-empty-transcript">Opening your most recent conversation…</p>
					</div>
					<form class="composer" id="desk-composer" action="/desk/" method="post">
						<div class="attachment-preview" id="desk-attachment-preview" aria-live="polite"></div>
						<label class="visually-hidden" for="desk-message">Message Waffle</label>
						<textarea id="desk-message" name="message" rows="1" placeholder="Ask Waffle to help…" aria-describedby="desk-composer-hint"></textarea>
						<input id="desk-attach" type="file" accept="image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,text/markdown,text/csv,text/html,text/xml" multiple hidden/>
						<div class="slash-menu" id="desk-slash-menu" role="listbox" aria-label="Commands and skills" hidden></div>
						<p class="composer-hint visually-hidden" id="desk-composer-hint">Attach images or documents with the button, drag-and-drop, or paste. Enter sends. Shift+Enter adds a new line.</p>
						<p id="desk-composer-status" class="composer-status" role="status" aria-live="polite" hidden></p>
						<div class="queue-banner" id="desk-queue" aria-label="Follow-up queue" hidden></div>
						<div class="composer-toolbar">
							<div class="composer-session">
								<div class="model-field">
									<label for="desk-model">Session model</label>
									<select id="desk-model" name="model" aria-describedby="desk-model-detail desk-model-status" disabled>
										<option value={ view.ModelAlias }>{ view.ModelAlias }</option>
									</select>
									<p id="desk-model-detail" class="model-detail visually-hidden" aria-live="polite"></p>
									<p id="desk-model-status" class="visually-hidden">Changes this conversation only.</p>
								</div>
								<div class="model-field session-skill-field">
									<label for="desk-skill">Session skill</label>
									<div class="session-skill-row">
										<select id="desk-skill" name="skill" aria-describedby="desk-skill-status" disabled></select>
										<button type="button" id="desk-skill-toggle" disabled>Attach skill</button>
									</div>
									<p id="desk-skill-status" class="visually-hidden">Changes this conversation only.</p>
								</div>
								<div class="turn-mode-fields">
									<div class="model-field">
										<label for="desk-task-mode">Task mode</label>
										<select id="desk-task-mode" name="task_mode" aria-describedby="desk-task-mode-status" disabled>
											<option value="">Standard</option>
											<option value="quick">Quick answer</option>
											<option value="deep">Deep reasoning</option>
											<option value="draft">Draft</option>
										</select>
										<p id="desk-task-mode-status" class="visually-hidden">Adds trusted guidance; never widens posture.</p>
									</div>
									<div class="model-field">
										<label for="desk-reasoning">Reasoning effort</label>
										<select id="desk-reasoning" name="reasoning_effort" aria-describedby="desk-reasoning-status" disabled>
											<option value="">Provider default</option>
											<option value="low">Low</option>
											<option value="medium">Medium</option>
											<option value="high">High</option>
										</select>
										<p id="desk-reasoning-status" class="visually-hidden">Recorded per turn; applied when the provider supports it.</p>
									</div>
								</div>
							</div>
							<div class="composer-actions">
								<button id="desk-cancel" type="button" class="cancel-button" disabled>Cancel turn</button>
								<button id="desk-schedule-draft" type="button" class="schedule-button" disabled>Schedule draft</button>
								<div class="dictate-control">
									<button id="desk-dictate" type="button" class="dictate-button" aria-pressed="false" aria-describedby="desk-dictate-hint" disabled>Dictate</button>
									<p class="dictate-hint visually-hidden" id="desk-dictate-hint">Browser speech may process audio off-device. It is not sent to Waffle.</p>
								</div>
								<button id="desk-attach-button" type="button" class="attach-button" disabled>Attach</button>
								<button id="desk-send" type="submit" class="send-button" disabled>Send message</button>
							</div>
						</div>
					</form>
				</div>
			</section>
			<aside class="desk-canvas" id="desk-canvas-drawer" aria-labelledby="canvas-title" hidden>
				<div class="canvas-header">
					<div>
						<p class="eyebrow">Context</p>
						<h2 id="canvas-title">Session and files</h2>
					</div>
					<button type="button" id="desk-canvas-close">Close canvas</button>
				</div>
				<div class="canvas-tabs" role="tablist" aria-label="Session context">
					<button type="button" id="desk-canvas-tab-artifact" role="tab" aria-controls="desk-canvas-artifact" aria-selected="false" hidden>Artifact</button>
					<button type="button" id="desk-canvas-tab-session" role="tab" aria-controls="desk-canvas-session" aria-selected="true">Session</button>
					<button type="button" id="desk-canvas-tab-diagnostics" role="tab" aria-controls="desk-canvas-diagnostics" aria-selected="false">Diagnostics</button>
					<button type="button" id="desk-canvas-tab-project" role="tab" aria-controls="desk-canvas-project" aria-selected="false">Project</button>
				</div>
				<section id="desk-canvas-artifact" class="canvas-panel" role="tabpanel" aria-labelledby="desk-canvas-tab-artifact" hidden></section>
				<section id="desk-canvas-session" class="canvas-panel" role="tabpanel" aria-labelledby="desk-canvas-tab-session">
					<div class="conversation-actions">
						<label id="desk-temporary-row" class="temporary-row" for="desk-temporary" hidden>
							<input id="desk-temporary" type="checkbox"/>
							<span>Temporary conversation</span>
						</label>
						<p id="desk-temporary-badge" class="temporary-badge" hidden>Temporary — nothing is saved</p>
						<label class="visually-hidden" for="desk-export-format">Export format</label>
						<select id="desk-export-format" disabled>
							<option value="markdown">Markdown</option>
							<option value="json">Versioned JSON</option>
						</select>
						<button type="button" id="desk-export" disabled>Export</button>
					</div>
				<dl class="context-list">
					<div class="visually-hidden">
						<dt>Connection</dt>
						<dd id="desk-connection-detail">{ view.Connection }</dd>
					</div>
					<div>
						<dt>Profile</dt>
						<dd id="desk-profile">—</dd>
					</div>
					<div>
						<dt>Posture</dt>
						<dd>
							<button id="desk-posture-open" class="posture-trigger" type="button" data-posture-open>View system prompt and policy</button>
						</dd>
					</div>
					<div>
						<dt>Workspace</dt>
						<dd id="desk-workspace">No workspace</dd>
					</div>
					<div>
						<dt>Provider</dt>
						<dd id="desk-provider">—</dd>
					</div>
					<div>
						<dt>Sandbox</dt>
						<dd id="desk-sandbox">—</dd>
					</div>
					<div id="desk-model-error-row" hidden>
						<dt>Model error</dt>
						<dd id="desk-model-error"></dd>
					</div>
					<div id="desk-fork-row" hidden>
						<dt>Branched from</dt>
						<dd id="desk-fork"></dd>
					</div>
					</dl>
				</section>
				<section id="desk-canvas-diagnostics" class="canvas-panel" role="tabpanel" aria-labelledby="desk-canvas-tab-diagnostics" hidden>
					<div class="context-panels">
						<details open>
							<summary>Usage</summary>
							<div id="desk-usage" class="context-panel-result" aria-live="polite"></div>
						</details>
						<details open>
							<summary>Permissions</summary>
							<div id="desk-permissions" class="context-panel-result" aria-live="polite"></div>
						</details>
						<details open>
							<summary>Working set</summary>
							<div id="desk-workset" class="context-panel-result" aria-live="polite"></div>
						</details>
						<details open>
							<summary>Commands</summary>
							<div id="desk-help" class="context-panel-result" aria-live="polite"></div>
						</details>
					</div>
				</section>
				<section id="desk-canvas-project" class="canvas-panel" role="tabpanel" aria-labelledby="desk-canvas-tab-project" hidden>
					<div class="context-panels">
						<div class="project-context-panel">
							<h3>Project context</h3>
							<p class="context-panel-hint">Reusable notes and workspace files for this conversation.</p>
							<div id="desk-project" class="context-panel-result" aria-live="polite"></div>
							<form class="project-form" id="desk-project-pin-form">
								<label for="desk-project-path">Pin workspace file</label>
								<div class="project-form-row">
									<input id="desk-project-path" name="path" type="text" placeholder="docs/plan.md" autocomplete="off">
									<button type="submit" id="desk-project-pin" disabled>Pin file</button>
								</div>
							</form>
							<form class="project-form" id="desk-project-note-form">
								<label for="desk-project-note-name">Add owner note</label>
								<div class="project-form-row">
									<input id="desk-project-note-name" name="name" type="text" placeholder="Guidance" autocomplete="off">
								</div>
								<textarea id="desk-project-note" name="note" rows="2" placeholder="Note body…"></textarea>
								<button type="submit" id="desk-project-add-note" disabled>Add note</button>
							</form>
						</div>
					</div>
				</section>
			</aside>
		</div>
		@PostureDialog()
	</section>
}
