package ui

templ FragmentList(view FragmentView) {
	<div id={ view.ID } class={ view.Class } data-waffle-fragment="true" if view.GetURL != "" { hx-get={ view.GetURL } hx-trigger={ view.Trigger } hx-target="this" hx-swap="outerHTML" }>
		if view.SummaryText != "" {
			<p class="capability-summary" id={ view.SummaryID } aria-live="polite">{ view.SummaryText }</p>
		}
		if view.Status != "" {
			<p class="waffle-fragment-status" role="status">{ view.Status }</p>
		}
		if len(view.Items) == 0 {
			if view.EmptyState != nil {
				@WaffleEmptyState(*view.EmptyState)
			} else {
				<p class="waffle-fragment-empty">{ view.Empty }</p>
			}
		}
		for _, item := range view.Items {
			<article class={ item.Class } data-waffle-id={ item.ID } data-task-id={ item.DataTaskID } data-workspace-id={ item.DataWorkspaceID } data-status={ item.Kind } data-task-name={ item.DataTaskName } data-task-cron={ item.DataTaskCron } data-task-prompt={ item.DataTaskPrompt } data-task-deliver={ item.DataTaskDeliver } data-task-profile={ item.DataTaskProfile } data-task-enabled={ fragmentBool(item.DataTaskEnabled) } data-task-redacted-fields={ item.DataTaskRedactedFields }>
				if !item.KindAfterTitle && item.Kind != "" {
					<p class={ fragmentKindClass(item) }>{ item.Kind }</p>
				}
				if item.Title != "" {
					<h3>{ item.Title }</h3>
				}
				if item.KindAfterTitle && item.Kind != "" {
					<p class={ fragmentKindClass(item) }>{ item.Kind }</p>
				}
				if item.Excerpt != "" {
					if item.ExcerptLong {
						<details class="waffle-fragment-expand">
							<summary>Show full text</summary>
							<p class="waffle-fragment-excerpt">{ item.Excerpt }</p>
						</details>
					} else {
						<p class="waffle-fragment-excerpt">{ item.Excerpt }</p>
					}
				}
				if item.Detail != "" && !item.DetailAfterFields {
					if item.DetailClass != "" {
						<p class={ item.DetailClass }>{ item.Detail }</p>
					} else {
						<p class="waffle-fragment-detail">{ item.Detail }</p>
					}
				}
				if len(item.Fields) > 0 {
					<dl class="waffle-fragment-facts">
						for _, field := range item.Fields {
							<div><dt>{ field.Label }</dt><dd>{ field.Value }</dd></div>
						}
					</dl>
				}
				if item.Detail != "" && item.DetailAfterFields {
					if item.DetailClass != "" {
						<p class={ item.DetailClass }>{ item.Detail }</p>
					} else {
						<p class="waffle-fragment-detail">{ item.Detail }</p>
					}
				}

				if len(item.PrimaryActions) > 0 || len(item.SecondaryActions) > 0 || len(item.MoreActions) > 0 {
					<div class="waffle-fragment-actions">
						for _, action := range item.PrimaryActions {
							@FragmentActionControl(action, action.Class)
						}
						for _, action := range item.SecondaryActions {
							@FragmentActionControl(action, action.Class)
						}
						if len(item.MoreActions) > 0 {
							<details id={ item.MoreActionsID } class="workspace-more-actions">
								<summary data-waffle-action-id={ item.MoreActionsID } aria-label={ item.MoreActionsLabel }>More actions</summary>
								<div class="workspace-more-actions-panel">
									for _, action := range item.MoreActions {
										@FragmentActionControl(action, action.Class)
									}
								</div>
							</details>
						}
					</div>
				} else if len(item.Actions) > 0 {
					<div class="waffle-fragment-actions">
						for _, action := range item.Actions {
							@FragmentActionControl(action, action.Class)
						}
					</div>
				}
			</article>
		}
		for _, footer := range view.Footers {
			<p id={ footer.ID } class={ footer.Class } data-waffle-skill-source={ footer.Source } data-waffle-source-available={ fragmentBool(footer.Available) }>{ footer.Text }</p>
		}
	</div>
	for _, options := range view.OptionLists {
		<select id={ options.ID } name={ options.Name } required?={ options.Required } hx-swap-oob="outerHTML">
			if len(options.Options) == 0 {
				<option value="">No available choices</option>
			}
			for _, option := range options.Options {
				<option value={ option.Value }>{ option.Label }</option>
			}
		</select>
	}
	for _, swap := range view.TextSwaps {
		<p id={ swap.ID } class={ swap.Class } { fragmentLiveAttributes(swap.Live)... } hx-swap-oob="outerHTML" data-waffle-skill-source={ swap.Source } data-waffle-source-available={ fragmentBool(swap.Available) }>{ swap.Text }</p>
	}
	if view.ID == "tasks-list" {
		if view.TaskScheduleOpenPrimary {
			<button id="task-schedule-open" class="action-primary" type="button" hx-swap-oob="outerHTML">New schedule</button>
		} else {
			<button id="task-schedule-open" type="button" hx-swap-oob="outerHTML">New schedule</button>
		}
	}
	for _, filter := range view.Filters {
		<button id={ filter.ID } class="task-filter" type="button" data-task-filter={ filter.Name } aria-pressed={ fragmentBool(filter.Pressed) } hx-get={ filter.URL } hx-target="#tasks-list" hx-swap="outerHTML" hx-swap-oob="outerHTML">{ filter.Label }</button>
	}
}

templ FragmentActionControl(action FragmentAction, class string) {
	if action.Method == "get" {
		<a class={ class } data-waffle-action-id={ action.ID } href={ action.URL }>{ action.Label }</a>
	} else if action.Method == "copy" {
		if action.HasPressed {
			<button class={ class } data-waffle-action-id={ action.ID } type="button" data-waffle-copy={ action.Value } disabled?={ action.Disabled } aria-pressed={ fragmentBool(action.Pressed) }>{ action.Label }</button>
		} else {
			<button class={ class } data-waffle-action-id={ action.ID } type="button" data-waffle-copy={ action.Value } disabled?={ action.Disabled }>{ action.Label }</button>
		}
	} else if action.Method == "edit" {
		if action.HasPressed {
			<button class={ class } data-waffle-action-id={ action.ID } data-waffle-task-edit="true" type="button" disabled?={ action.Disabled } aria-pressed={ fragmentBool(action.Pressed) }>{ action.Label }</button>
		} else {
			<button class={ class } data-waffle-action-id={ action.ID } data-waffle-task-edit="true" type="button" disabled?={ action.Disabled }>{ action.Label }</button>
		}
	} else if action.Method == "filter" {
		<button class={ class } data-waffle-action-id={ action.ID } type="button" hx-get={ action.URL } hx-target={ action.Target } hx-swap={ action.Swap } disabled?={ action.Disabled }>{ action.Label }</button>
	} else {
		<form class={ fragmentActionFormClass(action) } hx-post={ action.URL } hx-target={ action.Target } hx-swap={ action.Swap } hx-include={ action.Include } data-waffle-json="true">
			for _, field := range action.Fields {
				<input type="hidden" name={ field.Label } value={ field.Value }/>
			}
			for _, input := range action.Inputs {
				<label for={ input.ID }>{ input.Label }</label>
				<input id={ input.ID } name={ input.Name } type={ input.Type } placeholder={ input.Placeholder } value={ input.Value } required?={ input.Required }/>
			}
			if action.HasPressed {
				<button class={ class } data-waffle-action-id={ action.ID } type="submit" hx-disabled-elt="this" disabled?={ action.Disabled } aria-pressed={ fragmentBool(action.Pressed) }>{ action.Label }</button>
			} else {
				<button class={ class } data-waffle-action-id={ action.ID } type="submit" hx-disabled-elt="this" disabled?={ action.Disabled }>{ action.Label }</button>
			}
		</form>
	}
}

templ FragmentStatus(view FragmentStatusView) {
	<div class="waffle-fragment-status" role="status" data-waffle-error={ view.Error }>{ view.Message }</div>
	if view.RestartRequired {
		<div id="capability-restart-status" class="capability-restart" role="status" aria-live="polite" hx-swap-oob="outerHTML">
			<strong>Restart required.</strong>
			<span>Waiting for a new Waffle process. If it does not arrive, restart waffle serve.</span>
		</div>
	}
}
