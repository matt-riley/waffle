package ui

templ Tasks(view ShellView) {
	<section class="tasks" data-section={ view.ActiveSection } aria-labelledby="tasks-title">
		<header class="tasks-header">
			<div>
				<p class="eyebrow">Tasks</p>
				<h1 id="tasks-title">What Waffle is carrying</h1>
			</div>
			<div class="tasks-header-actions">
				<p class="tasks-attention" id="tasks-attention-count" aria-live="polite">Checking attention…</p>
				<button id="task-schedule-open" type="button">New schedule</button>
			</div>
		</header>
		<div class="task-filters" aria-label="Filter tasks">
			<button id="task-filter-all" class="task-filter" type="button" data-task-filter="all" aria-pressed="true" hx-get="/api/v1/desk/tasks?filter=all" hx-target="#tasks-list" hx-swap="outerHTML">All</button>
			<button id="task-filter-active" class="task-filter" type="button" data-task-filter="active" aria-pressed="false" hx-get="/api/v1/desk/tasks?filter=active" hx-target="#tasks-list" hx-swap="outerHTML">Active</button>
			<button id="task-filter-scheduled" class="task-filter" type="button" data-task-filter="scheduled" aria-pressed="false" hx-get="/api/v1/desk/tasks?filter=scheduled" hx-target="#tasks-list" hx-swap="outerHTML">Scheduled</button>
			<button id="task-filter-completed" class="task-filter" type="button" data-task-filter="completed" aria-pressed="false" hx-get="/api/v1/desk/tasks?filter=completed" hx-target="#tasks-list" hx-swap="outerHTML">Completed</button>
			<button id="task-filter-attention" class="task-filter" type="button" data-task-filter="attention" aria-pressed="false" hx-get="/api/v1/desk/tasks?filter=attention" hx-target="#tasks-list" hx-swap="outerHTML">Attention</button>
		</div>
		<div class="tasks-errors" id="tasks-errors" role="status" aria-live="polite" hidden></div>
		<div class="tasks-layout">
			<section class="tasks-board" aria-labelledby="tasks-board-title">
				<div class="panel-heading">
					<div>
						<h2 id="tasks-board-title">Runs and schedules</h2>
					</div>
				</div>
				<div class="task-list" id="tasks-list" hx-get="/api/v1/desk/tasks?filter=all" hx-trigger="load" hx-target="this" hx-swap="outerHTML"></div>
				<p class="tasks-empty" id="tasks-empty">Loading task evidence…</p>
			</section>
		</div>
		<dialog id="task-schedule-dialog" aria-labelledby="schedule-editor-title">
			<aside class="schedule-editor" aria-labelledby="schedule-editor-title">
				<div class="panel-heading">
					<div>
						<h2 id="schedule-editor-title">Set the next rhythm</h2>
					</div>
				</div>
				<form id="task-schedule-form" hx-post="/api/v1/desk/tasks/schedules" hx-target="#task-schedule-status" hx-swap="innerHTML" data-waffle-json="true" data-waffle-json-kind="task-schedule">
					<input id="task-schedule-id" name="id" type="hidden" disabled/>
					<label for="task-schedule-name">Name</label>
					<input id="task-schedule-name" name="name" required/>
					<label for="task-schedule-prompt">Prompt</label>
					<textarea id="task-schedule-prompt" name="prompt" rows="5" required></textarea>

					<fieldset class="schedule-guide" id="task-schedule-guide">
						<legend>When should it run?</legend>
						<label for="task-schedule-cadence">Cadence</label>
						<select id="task-schedule-cadence" name="cadence">
							<option value="weekdays">Every weekday</option>
							<option value="daily">Every day</option>
							<option value="weekly">Once a week</option>
							<option value="monthly">Once a month</option>
						</select>
						<label for="task-schedule-time">Time</label>
						<input id="task-schedule-time" name="time" type="time" value="09:00" required/>
						<label id="task-schedule-dow-row" for="task-schedule-dow">Day of week</label>
						<select id="task-schedule-dow" name="dow" hidden>
							<option value="1">Monday</option>
							<option value="2">Tuesday</option>
							<option value="3">Wednesday</option>
							<option value="4">Thursday</option>
							<option value="5">Friday</option>
							<option value="6">Saturday</option>
							<option value="0">Sunday</option>
						</select>
						<label id="task-schedule-dom-row" for="task-schedule-dom">Day of month</label>
						<select id="task-schedule-dom" name="dom" hidden>
							<option value="1">1st</option>
							<option value="2">2nd</option>
							<option value="3">3rd</option>
							<option value="4">4th</option>
							<option value="5">5th</option>
							<option value="10">10th</option>
							<option value="15">15th</option>
							<option value="20">20th</option>
							<option value="25">25th</option>
							<option value="28">28th</option>
						</select>
						<p class="schedule-summary" id="task-schedule-summary" aria-live="polite"></p>
					</fieldset>

					<details class="schedule-advanced" id="task-schedule-advanced">
						<summary>Advanced: raw cron</summary>
						<label for="task-schedule-cron">Cron schedule</label>
						<input id="task-schedule-cron" name="cron" placeholder="0 9 * * 1-5" autocomplete="off"/>
						<p class="schedule-help">Five fields: minute, hour, day of month, month, day of week. Examples: <code>0 9 * * 1-5</code> every weekday at 09:00; <code>30 8 1 * *</code> monthly on the 1st at 08:30.</p>
					</details>

					<label for="task-schedule-deliver">Delivery destination <span>(optional)</span></label>
					<div class="schedule-delivery-row">
						<select id="task-schedule-deliver" name="deliver" data-waffle-deliver-select>
							<option value="">Log only (no delivery)</option>
						</select>
						<input id="task-schedule-chat-id" name="chat_id" placeholder="chat id" autocomplete="off" hidden/>
					</div>
					<p class="schedule-hint" id="task-schedule-deliver-hint" hidden></p>
					<label id="task-schedule-deliver-clear-row" for="task-schedule-deliver-clear" hidden class="schedule-enabled schedule-clear">
						<input id="task-schedule-deliver-clear" type="checkbox"/>
						Clear stored delivery target
					</label>
					<label for="task-schedule-profile">Profile <span>(optional)</span></label>
					<select id="task-schedule-profile" name="profile">
						<option value="">Group default</option>
					</select>
					<p class="schedule-hint" id="task-schedule-profile-hint" hidden></p>
					<label id="task-schedule-profile-clear-row" for="task-schedule-profile-clear" hidden class="schedule-enabled schedule-clear">
						<input id="task-schedule-profile-clear" type="checkbox"/>
						Clear stored profile
					</label>
					<label id="task-schedule-enabled-row" for="task-schedule-enabled" hidden class="schedule-enabled">
						<input id="task-schedule-enabled" name="enabled" type="checkbox" checked disabled/>
						Enabled
					</label>
					<div id="task-schedule-field-errors" class="schedule-field-errors" role="status" aria-live="polite" hidden></div>
					<div class="schedule-actions">
						<button id="task-schedule-cancel" type="button">Cancel</button>
						<button id="task-schedule-submit" class="send-button" type="submit">Create schedule</button>
					</div>
					<div id="task-schedule-status" class="schedule-status" aria-live="polite"></div>
				</form>
			</aside>
		</dialog>
	</section>
}
