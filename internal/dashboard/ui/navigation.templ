package ui

templ Navigation(view ShellView) {
	<nav class="desk-navigation" aria-label="Waffle Desk sections">
		<a class="brand" href="/desk/" aria-label="Waffle Desk home">
			<img class="brand-waffle" src={ AssetURL("waffle-mark-sitting.png", view.AssetVersion) } width="128" height="128" alt="" aria-hidden="true"/>
			<span>Waffle Desk</span>
		</a>
		<button id="palette-open" class="palette-open" type="button" aria-haspopup="dialog" aria-controls="command-palette">Commands <kbd>Ctrl K</kbd></button>
		<label class="theme-control">
			<span>Theme</span>
			<select id="desk-theme" aria-label="Theme">
				<option value="system">System</option>
				<option value="light">Light</option>
				<option value="dark">Dark</option>
			</select>
		</label>
		<ul class="section-links">
			@NavigationItem("today", "Today", view.ActiveSection)
			@NavigationItem("tasks", "Tasks", view.ActiveSection)
			@NavigationItem("workspaces", "Workspaces", view.ActiveSection)
			@NavigationItem("memory", "Memory", view.ActiveSection)
			@NavigationItem("capabilities", "Capabilities", view.ActiveSection)
		</ul>
		if view.ActiveSection == "today" || view.ActiveSection == "" {
			@TodaySessionRail()
		}
		<div
			class="rail-status"
			id="rail-status"
			data-connection-state="connecting"
			aria-live="polite"
			aria-label={ "Connection and model: " + view.Connection + ", " + view.ModelAlias }
		>
			<span class="status-dot is-connecting" id="rail-status-dot" aria-hidden="true"></span>
			<span id="rail-connection">{ view.Connection }</span>
			<code id="rail-model" data-model-scope="">{ view.ModelAlias }</code>
		</div>
	</nav>
}

templ TodaySessionRail() {
	<div class="desk-session-rail" id="desk-session-rail">
		<button id="desk-session-refresh" type="button" aria-expanded="false" hidden>Recent conversations</button>
		<div class="desk-session-drawer" id="desk-sessions" role="region" aria-labelledby="desk-session-drawer-title" hidden>
			<div class="desk-session-drawer-head">
				<h2 id="desk-session-drawer-title">Conversations</h2>
				<button id="desk-session-drawer-close" type="button">Close</button>
			</div>
			<button id="desk-new" type="button" disabled>New conversation</button>
			<label class="visually-hidden" for="desk-session-filter">Find a conversation</label>
			<input type="search" id="desk-session-filter" placeholder="Find a conversation…" autocomplete="off" />
			<div class="session-list" id="desk-session-options" role="listbox" aria-label="Recent conversations" aria-live="polite">
				<p>Opening recent conversations…</p>
			</div>
		</div>
	</div>
}

templ NavigationItem(section string, label string, active string) {
	<li>
		if section == active {
			<a href={ "/desk/?section=" + section } data-desk-section={ section } aria-current="page">{ label }</a>
		} else {
			<a href={ "/desk/?section=" + section } data-desk-section={ section }>{ label }</a>
		}
	</li>
}
