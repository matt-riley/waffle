package ui

templ Navigation(view ShellView) {
	<nav class="desk-navigation" aria-label="Waffle Desk sections">
		<a class="brand" href="/desk/" aria-label="Waffle Desk home">Waffle Desk</a>
		<ul class="section-links">
			@NavigationItem("today", "Today", view.ActiveSection)
			@NavigationItem("tasks", "Tasks", view.ActiveSection)
			@NavigationItem("workspaces", "Workspaces", view.ActiveSection)
			@NavigationItem("memory", "Memory", view.ActiveSection)
			@NavigationItem("capabilities", "Capabilities", view.ActiveSection)
		</ul>
		<div
			class="rail-status"
			id="rail-status"
			data-connection-state="connecting"
			aria-live="polite"
			aria-label={ "Connection and model: " + view.Connection + ", " + view.ModelAlias }
		>
			<span class="status-dot is-connecting" id="rail-status-dot" aria-hidden="true"></span>
			<span id="rail-connection">{ view.Connection }</span>
			<code id="rail-model" data-model-scope="">{ view.ModelAlias }</code>
		</div>
	</nav>
}

templ NavigationItem(section string, label string, active string) {
	<li>
		if section == active {
			<a href={ "/desk/?section=" + section } data-desk-section={ section } aria-current="page">{ label }</a>
		} else {
			<a href={ "/desk/?section=" + section } data-desk-section={ section }>{ label }</a>
		}
	</li>
}
