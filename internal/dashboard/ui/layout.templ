package ui

templ Shell(view ShellView) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ view.Title }</title>
			if view.ActiveSection != "today" {
				@HtmxAssets(view)
			}
			<link rel="stylesheet" href={ AssetURL("app.css", view.AssetVersion) }/>
			<script type="module" src={ AssetURL("app.js", view.AssetVersion) }></script>
			if view.ActiveSection == "workspaces" {
				@WorkspaceAssets(view)
			}
			if view.ActiveSection == "memory" {
				@MemoryAssets(view)
			}
			if view.ActiveSection == "capabilities" {
				@CapabilitiesAssets()
				@ProfileAssets(view)
			}
			// Posture is read from Today (the live session) and from
			// Capabilities (per profile), so both sections load it (#193).
			if view.ActiveSection == "capabilities" || view.ActiveSection == "today" || view.ActiveSection == "" {
				@PostureAssets(view)
				// Capabilities renders the full setup checklist; Today loads
				// the same module for its banner, so an install that cannot
				// open a conversation still says why (#192).
				@SetupAssets(view)
			}
		</head>
		<body data-request-token={ view.RequestToken }>
			<a class="skip-link" href="#main-content">Skip to main content</a>
			<div class="desk-shell" data-active-section={ view.ActiveSection }>
				@Navigation(view)
				<main id="main-content" tabindex="-1">
					switch view.ActiveSection {
						case "tasks":
							@Tasks(view)
						case "workspaces":
							@Workspaces(view)
						case "memory":
							@Memory(view)
						case "capabilities":
							@Capabilities()
						default:
							@Today(view)
					}
				</main>
			</div>
		</body>
	</html>
}
