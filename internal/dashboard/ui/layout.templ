package ui

templ Shell(view ShellView) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ view.Title }</title>
			<link rel="stylesheet" href={ AssetURL("app.css", view.AssetVersion) }/>
			<script type="module" src={ AssetURL("app.js", view.AssetVersion) }></script>
			if view.ActiveSection == "workspaces" {
				@WorkspaceAssets(view)
			}
		</head>
		<body data-request-token={ view.RequestToken }>
			<a class="skip-link" href="#main-content">Skip to main content</a>
			<div class="desk-shell" data-active-section={ view.ActiveSection }>
				@Navigation(view)
				<main id="main-content" tabindex="-1">
					switch view.ActiveSection {
						case "tasks":
							@Tasks(view)
						case "workspaces":
							@Workspaces(view)
						case "memory":
							@Memory(view)
						case "capabilities":
							@Capabilities(CapabilitiesView{AssetVersion: CapabilitiesAssetVersion()})
						default:
							@Today(view)
					}
				</main>
			</div>
		</body>
	</html>
}
