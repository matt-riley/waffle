package ui

templ CapabilitiesAssets() {
	<link rel="stylesheet" href={ CapabilitiesAssetURL("capabilities.css", CapabilitiesAssetVersion()) }/>
	<script type="module" src={ CapabilitiesAssetURL("capabilities.js", CapabilitiesAssetVersion()) }></script>
}

templ Capabilities() {
	<section class="capabilities" id="desk-capabilities" aria-labelledby="capabilities-title">
		<header class="capabilities-header">
			<div>
				<p class="eyebrow">Capabilities / deliberate changes</p>
				<h1 id="capabilities-title">Models, skills, and connections</h1>
			</div>
			<p class="capability-status" id="capability-status" role="status" aria-live="polite">Loading capabilities…</p>
		</header>
		<div class="capability-restart" id="capability-restart-status" role="status" aria-live="polite" hidden>
			<strong>Restart required.</strong>
			<span>Waiting for a new Waffle process. If it does not arrive, restart waffle serve.</span>
		</div>
		<nav class="capability-tabs" aria-label="Capability sections">
			<a href="#setup-checklist">Setup</a>
			<a href="#capability-models-panel">Models</a>
			<a href="#capability-skills-panel">Skills</a>
			<a href="#capability-connections-panel">Tools &amp; connections</a>
		</nav>
		<div class="capability-grid">
			@SetupChecklist()
			<section class="capability-panel" id="capability-models-panel" aria-labelledby="capability-models-title">
				<header>
					<p class="panel-index">01 / models</p>
					<h2 id="capability-models-title">Choose where Waffle thinks</h2>
				</header>
				<div id="capability-models" class="capability-list"></div>
				<div class="capability-form-grid">
					<form id="capability-default-form" aria-describedby="capability-default-status">
						<h3>Waffle-wide default</h3>
						<label for="capability-default-alias">Model alias</label>
						<select id="capability-default-alias" name="alias" required></select>
						<p id="capability-default-empty" class="scope-note" hidden></p>
						<button type="submit">Set default</button>
						<p class="capability-form-status" id="capability-default-status" role="status" aria-live="polite"></p>
					</form>
					<form id="capability-utility-form" aria-describedby="capability-utility-status">
						<h3>Utility model</h3>
						<label for="capability-utility-alias">Model alias</label>
						<select id="capability-utility-alias" name="alias" required></select>
						<p id="capability-utility-empty" class="scope-note" hidden></p>
						<button type="submit">Set utility model</button>
						<p class="capability-form-status" id="capability-utility-status" role="status" aria-live="polite"></p>
					</form>
				</div>
				<p class="scope-note"><strong>Session</strong> model choices live on Today and change one conversation only. The controls above are Waffle-wide. Alias removal always starts with a fresh reference preview and requires an explicit replacement when needed.</p>
				<form id="capability-catalogue-form" class="capability-catalogue-form" aria-describedby="capability-catalogue-status">
					<h3>Browse a provider catalogue</h3>
					<label for="capability-catalogue-connection">Enrolled connection</label>
						<select id="capability-catalogue-connection" name="connection" required></select>
						<p id="capability-catalogue-empty" class="scope-note" hidden></p>
					<button type="submit">Refresh catalogue</button>
					<p class="capability-form-status" id="capability-catalogue-status" role="status" aria-live="polite"></p>
				</form>
				<div class="capability-catalogue-search">
					<label for="capability-catalogue-search">Search refreshed models</label>
					<input id="capability-catalogue-search" type="search" placeholder="Model name or ID"/>
					<p id="capability-catalogue-summary" class="scope-note" aria-live="polite">Refresh a connection to browse its models.</p>
				</div>
				<div id="capability-catalogue-results" class="capability-list"></div>
				<form id="capability-model-form" aria-describedby="capability-model-status">
					<h3>Add a model from an enrolled provider</h3>
					<label for="capability-model-connection">Connection</label>
						<select id="capability-model-connection" name="connection_name" required></select>
						<p id="capability-model-connection-empty" class="scope-note" hidden></p>
					<label for="capability-model-alias">Alias</label>
					<input id="capability-model-alias" name="alias" required/>
					<label for="capability-model-id">Provider model ID</label>
					<input id="capability-model-id" name="upstream_model" required/>
					<button type="submit">Add model</button>
					<p class="capability-form-status" id="capability-model-status" role="status" aria-live="polite"></p>
				</form>
			</section>
			<section class="capability-panel" id="capability-skills-panel" aria-labelledby="capability-skills-title">
				<header>
					<p class="panel-index">02 / skills</p>
					<h2 id="capability-skills-title">Reviewed skills</h2>
				</header>
				<div id="capability-skills" class="capability-list"></div>
				<p id="capability-skill-stage-prerequisite" class="capability-form-status" role="status" aria-live="polite" hidden></p>
				<form id="capability-skill-stage-form" aria-describedby="capability-skill-stage-status">
					<h3>Add a skill for review</h3>
					<label for="capability-skill-local-path">Local skill path</label>
					<p id="capability-skill-local-help" class="skill-source-help"></p>
					<input id="capability-skill-local-path" name="local_path" autocomplete="off"/>
					<label for="capability-skill-git-url">Git skill URL</label>
					<p id="capability-skill-git-help" class="skill-source-help"></p>
					<input id="capability-skill-git-url" name="git_url" type="url" autocomplete="off"/>
					<label for="capability-skill-commit">Exact Git commit (40 lowercase hex)</label>
					<input id="capability-skill-commit" name="commit" autocomplete="off"/>
					<button type="submit">Stage review</button>
					<p class="capability-form-status" id="capability-skill-stage-status" role="status" aria-live="polite"></p>
				</form>
				<section id="capability-skill-review" class="skill-review" aria-labelledby="capability-skill-review-title" hidden>
					<h3 id="capability-skill-review-title">Review manifest and diff</h3>
					<div id="capability-skill-preview" class="skill-review-content"></div>
					<p id="capability-skill-review-expires" class="skill-review-expiry" role="status" aria-live="polite"></p>
					<button type="button" id="capability-skill-install" aria-describedby="capability-skill-install-status">Install inactive</button>
					<p class="capability-form-status" id="capability-skill-install-status" role="status" aria-live="polite"></p>
				</section>
			</section>
			<section class="capability-panel" id="capability-connections-panel" aria-labelledby="capability-connections-title">
				<header>
					<p class="panel-index">03 / tools &amp; connections</p>
					<h2 id="capability-connections-title">Tools &amp; connections</h2>
				</header>
				<p class="scope-note"><strong>Connection health only.</strong> Credentials, endpoints, commands, environment, and tool policy details stay private. Provider removal is previewed first and stays blocked while model aliases reference the connection.</p>
				<div id="capability-connections" class="capability-list connection-list">
					Loading tools and connections…
				</div>
				<form id="capability-provider-form" autocomplete="off" aria-describedby="capability-provider-status">
					<h3>Enroll a provider</h3>
					<label for="capability-provider-name">Connection name</label>
					<input id="capability-provider-name" name="connection_name" required autocomplete="off"/>
					<label for="capability-provider-type">Provider type</label>
						<select id="capability-provider-type" name="type" required autocomplete="off"></select>
						<label for="capability-provider-base-url">Base URL</label>
						<input id="capability-provider-base-url" name="base_url" type="url" autocomplete="off"/>
						<p class="scope-note" id="capability-provider-base-url-guidance">Choose a provider type to see Base URL requirements.</p>
						<label for="capability-provider-max-tokens">Maximum tokens (optional)</label>
						<input id="capability-provider-max-tokens" name="max_tokens" type="number" min="0" inputmode="numeric" autocomplete="off"/>
					<label for="capability-provider-model-alias">First model alias</label>
					<input id="capability-provider-model-alias" name="model_alias" required autocomplete="off"/>
					<label for="capability-provider-model-id">Provider model ID</label>
					<input id="capability-provider-model-id" name="model_id" required autocomplete="off"/>
						<label for="capability-provider-credential">Credential</label>
						<input id="capability-provider-credential" name="api_key" type="password" autocomplete="off"/>
						<label><input id="capability-provider-default" name="make_default" type="checkbox"/> Make this first model the Waffle-wide default</label>
						<label><input id="capability-provider-utility" name="make_utility" type="checkbox"/> Make this first model the utility model</label>
						<button type="submit">Enroll provider</button>
						<button type="button" id="capability-provider-test">Test connection</button>
					<p class="capability-form-status" id="capability-provider-status" role="status" aria-live="polite"></p>
				</form>
			</section>
		</div>
		@PostureDialog()
		@ProfileEditor()
	</section>
}
