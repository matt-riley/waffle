package ui

templ WaffleEmptyState(view EmptyStateView) {
	<section class="waffle-empty-state" role="region" aria-labelledby={ view.TitleID }>
		<img class={ emptyStateArtworkClass(view) } src={ AssetURL(view.artwork.AssetName, AssetVersion()) } width={ view.artwork.Width } height={ view.artwork.Height } alt="" aria-hidden="true" loading="lazy" decoding="async"/>
		<div class="waffle-empty-state-copy">
			<h2 id={ view.TitleID }>{ view.Title }</h2>
			<p>{ view.Body }</p>
			if view.PrimaryAction != nil || view.SecondaryAction != nil {
				<div class="waffle-empty-state-actions">
					if view.PrimaryAction != nil {
						@FragmentActionControl(*view.PrimaryAction, "waffle-empty-state-action action-primary")
					}
					if view.SecondaryAction != nil {
						@FragmentActionControl(*view.SecondaryAction, "waffle-empty-state-action action-quiet")
					}
				</div>
			}
		</div>
	</section>
}
