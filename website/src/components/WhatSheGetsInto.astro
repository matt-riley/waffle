---
import { Image } from 'astro:assets';
import curious from '../assets/waffle/curious.png';

const stories = [
	{
		title: 'Company (on her schedule)',
		body: 'Keyboard-first chat when you’re deep in something. She’ll show up, sit in the middle of it, and make herself useful.',
	},
	{
		title: 'Pokes the tools on purpose',
		body: 'Bash, files, fetch when a task needs hands. A sandbox keeps her curiosity from knocking over the whole house.',
	},
	{
		title: 'Hoards the good bits',
		body: 'Session memory for the moment. Durable notes for the scraps she refuses to forget.',
	},
];
---

<section
	id="what-she-does"
	class="bg-paper-warm/60 py-24"
	aria-labelledby="story-heading"
	data-story-section
>
	<div
		class="site-shell grid gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:gap-16"
	>
		<div data-scroll-anim>
			<p class="section-label">What she gets into</p>
			<h2 id="story-heading" class="section-title mt-3 max-w-lg">
				Three favorite crimes.
			</h2>

			<ul class="mt-12 space-y-0">
				{
					stories.map((item, i) => (
						<li class="border-t border-label/15 py-8 first:border-t-0 first:pt-0 last:pb-0" data-scroll-anim>
							<p class="font-display text-xs font-bold text-ginger">0{i + 1}</p>
							<h3 class="font-display mt-2 text-xl font-extrabold tracking-tight text-ink sm:text-2xl">
								{item.title}
							</h3>
							<p class="section-body mt-2 max-w-md text-base">{item.body}</p>
						</li>
					))
				}
			</ul>
		</div>

		<div class="flex justify-center lg:sticky lg:top-16 lg:justify-end max-lg:static" data-scroll-anim>
			<figure class="max-w-[18rem] text-center sm:max-w-[20rem]">
				{/*
				  Body stays still; a clipped duplicate of the same portrait tips at the neck.
				  (Single PNG — no separate head asset.)
				*/}
				<div class="story-cat" data-story-cat>
					<Image
						src={curious}
						alt="Waffle’s curious expression — grey-green eyes, alert ears"
						widths={[320, 480, 640]}
						sizes="(max-width: 1024px) 60vw, 320px"
						class="cat-img story-cat__body mx-auto h-auto w-full object-contain"
						loading="lazy"
					/>
					<div class="story-cat__head" data-story-cat-head aria-hidden="true">
						<Image
							src={curious}
							alt=""
							widths={[320, 480, 640]}
							sizes="(max-width: 1024px) 60vw, 320px"
							class="cat-img story-cat__head-img mx-auto h-auto w-full object-contain"
							loading="lazy"
						/>
					</div>
				</div>
				<figcaption class="section-body mt-4 text-sm">
					Plotting. Obviously plotting.
				</figcaption>
			</figure>
		</div>
	</div>
</section>
